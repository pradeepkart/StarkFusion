        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{userEmail}}\",\"password\":\"123456\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"userToken\", pm.response.json().token);"
            ]
          }
        }
      ]
    },

{
  "info": {
    "name": "Skill Gap Analyzer - JWT + MySQL",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order. Covers all required admin and user routes with token/ID capture. Creates sample records. Default admin credentials are development only."
  },
